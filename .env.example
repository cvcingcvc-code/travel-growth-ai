# TravelGrowth AI 环境变量模板
# 复制为 .env.local 并按需填写。严禁将真实密钥提交到 Git 仓库！

# 应用配置
APP_NAME=TravelGrowth AI
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_PATH=./data/travel-growth.db
UPLOAD_DIR=./uploads

# 默认 AI 文本模型配置（至少配置一项真实密钥以启用真实模型调用；未配置时自动进入明确标记的测试/未配置状态）
AI_DEFAULT_TEXT_PROVIDER=openai
AI_DEFAULT_TEXT_MODEL=gpt-4o-mini

# OpenAI / OpenAI-compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini
GEMINI_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# DeepSeek（配置 DEEPSEEK_API_KEY 后将自动路由至 deepseek-chat）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 限流、费用熔断与访问控制（防止公网恶意刷接口）
AI_RATE_LIMIT_PER_MIN=10
AI_DAILY_MAX_RUNS=200
AI_DAILY_MAX_TOKENS=300000
AI_MAX_OUTPUT_TOKENS=1800
AI_ACCESS_PASSCODE=

# Ollama (本地)
OLLAMA_BASE_URL=http://localhost:11434

# 图片生成模型配置（可选）
AI_IMAGE_PROVIDER=openai
AI_IMAGE_MODEL=dall-e-3

# Embedding 模型配置（可选，未配置时使用本地确定性 TF-IDF/词向量回退并明确标注）
AI_EMBEDDING_PROVIDER=openai
AI_EMBEDDING_MODEL=text-embedding-3-small

# 外部 Agent / MCP 接入密钥（默认最小权限）
AGENT_API_TOKEN=dev-agent-token-change-me
# 单个 Agent Token 锁定一个已授权的企业工作空间 ID
AGENT_ORGANIZATION_ID=
